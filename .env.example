# ResearchOS
# Copy this file to .env and fill in the values

# ==================== Database ====================
TIDB_HOST=127.0.0.1
TIDB_PORT=4000
TIDB_USER=root
TIDB_PASSWORD=
TIDB_DATABASE=research_os

# ==================== Elasticsearch ====================
ES_HOST=http://localhost:9200

# ==================== Redis ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== JWT ====================
JWT_SECRET=change-me-in-production-use-a-64-char-random-string
JWT_REFRESH_SECRET=change-me-too-another-64-char-random-string

# ==================== AI ====================
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-20250514

# ==================== Email ====================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@researchos.com

# ==================== Storage ====================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=research-os

# ==================== App ====================
API_PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
