{
  "name": "research-os",
  "private": true,
  "version": "1.0.0",
  "description": "多源证据驱动的 AI 调研决策系统",
  "workspaces": [
    "shared",
    "database",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n fe,be -c blue,green \"npm run dev:fe\" \"npm run dev:be\"",
    "dev:fe": "npm --workspace @research-os/frontend run dev",
    "dev:be": "npm --workspace @research-os/backend run dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npx playwright test",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "db:migrate": "npm --workspace @research-os/database run migrate",
    "db:seed": "npm --workspace @research-os/database run seed",
    "db:reset": "npm --workspace @research-os/database run reset"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
